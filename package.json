{
  "name": "sprimax-root",
  "version": "1.0.0",
  "description": "Sprimax - Modern MERN Stack Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix frontend -- ../admin --config ../frontend/vite.config.js --port 5174",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix frontend -- ../admin --config ../frontend/vite.config.js",
    "start:backend": "npm run start --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
